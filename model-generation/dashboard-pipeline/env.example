# Copy the four values for the environment where the pipeline will run.
# Do not put database passwords or API keys in this file.

# Local workstation example
TENKI_DASHBOARD_ROOT=/absolute/path/to/tenki-sales-search
TENKI_WORK_DIR=/absolute/path/to/tenki-work
TENKI_RAW_DATA_DIR=/absolute/path/to/tenki-raw-data
TENKI_DUCKDB_BIN=/absolute/path/to/duckdb

# Server example (use these instead of the local values above)
# TENKI_DASHBOARD_ROOT=/root/src/your-dashboard
# TENKI_WORK_DIR=/root/src/your-dashboard-work
# TENKI_RAW_DATA_DIR=/root
# TENKI_DUCKDB_BIN=/usr/local/bin/duckdb
# TENKI_SERVER_DATA_DIR=/opt/tenki-dashboard/site-data/data
